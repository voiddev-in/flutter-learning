# ============================================================
# flutter-learning — root .gitignore
# Platform folders (app/android, app/ios, ...) have their own
# .gitignore files that handle native generated files.
# ============================================================

# ---------- OS ----------
.DS_Store
Thumbs.db

# ---------- Editors / IDEs ----------
.idea/
*.iml
*.ipr
*.iws
*.swp
.history/
# .vscode/  (uncomment to keep VS Code settings out of git)

# ---------- Dart / Flutter ----------
.dart_tool/
.pub/
.pub-cache/
.flutter-plugins
.flutter-plugins-dependencies
build/
coverage/
**/doc/api/
.widget_preview/
**/generated_plugin_registrant.dart

# Keep pubspec.lock committed for apps (same dependency versions for everyone)
!pubspec.lock

# ---------- Generated plugin registrants (desktop) ----------
**/macos/Flutter/GeneratedPluginRegistrant.swift
**/windows/flutter/generated_plugin_registrant.*
**/windows/flutter/generated_plugins.cmake
**/linux/flutter/generated_plugin_registrant.*
**/linux/flutter/generated_plugins.cmake

# ---------- Logs / temp ----------
*.log
*.class
*.pyc
.buildlog/

# ---------- Build symbols / obfuscation maps ----------
app.*.symbols
app.*.map.json

# ---------- Secrets — NEVER commit ----------
.env
.env.*
*.jks
*.keystore
key.properties
